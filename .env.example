# Credito/colecoes
MLOPS_ENV=local
MLOPS_CLIENTS=6000
MLOPS_MONTHS=24
MLOPS_SEED=42

# API
API_KEY=
MLOPS_CORS_ORIGINS=*

# LLM / LangGraph
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MLOPS_USE_LLM=0

# TypeSafe / Jev
# Mantenha 0 para testes offline; use 1 apenas com uma chave válida.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=
MLOPS_USE_JEV=0
MLOPS_JEV_MAX_CALLS_PER_RUN=500
MLOPS_JEV_TIMEOUT=30

# Autopilot
MLOPS_AUTONOMY=full
MLOPS_AUTOPILOT_MAX_WORKERS=8
MLOPS_AUTOPILOT_OUTPUT=artifacts/autopilot
MLOPS_ARTIFACTS_BUCKET=
MLOPS_ALERT_WEBHOOK=
MLOPS_ALERT_DELINQUENCY_DELTA=0.02
MLOPS_ALERT_PSI=0.25

# RAG
MLOPS_USE_EMBEDDINGS=0
MLOPS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MLOPS_USE_RERANK=0
MLOPS_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Reranker ajustado ao domínio (gerado por scripts/train_reranker.py):
# MLOPS_RERANK_MODEL=artifacts/rag/reranker_ft_hard
MLOPS_USE_EXPANSION=1
MLOPS_USE_CONTEXTUAL=1
MLOPS_CONTEXT_WINDOW=1
MLOPS_CONTEXT_MAX_CHARS=2400
MLOPS_CONTEXT_CANDIDATES=3

# MLOps
MLOPS_ENABLE_MLFLOW=0
MLFLOW_TRACKING_URI=file:./mlruns
